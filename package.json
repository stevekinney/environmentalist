{
  "name": "@lostgradient/environmentalist",
  "version": "0.0.2",
  "description": "Type-safe environment variable loading, validation, and configuration resolution for Node, Bun, and the browser.",
  "keywords": [
    "browser",
    "bun",
    "configuration",
    "dotenv",
    "env",
    "environment",
    "environment-variables",
    "node",
    "typescript",
    "validation",
    "zod"
  ],
  "homepage": "https://github.com/stevekinney/environmentalist#readme",
  "bugs": {
    "url": "https://github.com/stevekinney/environmentalist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevekinney/environmentalist.git"
  },
  "license": "MIT",
  "author": "Steve Kinney <hello@stevekinney.net>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "node": "./dist/index.node.js",
      "bun": "./dist/index.node.js",
      "default": "./dist/index.node.js"
    },
    "./types": {
      "types": "./dist/types-entry.d.ts",
      "default": "./dist/types-entry.d.ts"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "node": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.node.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "environmentalist": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "clean": "rm -rf dist coverage node_modules/.cache/tsconfig.tsbuildinfo node_modules/.cache/tsconfig.test.tsbuildinfo",
    "dev": "bun --watch run src/index.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "oxlint --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint --fix --type-aware --tsconfig ./tsconfig.json",
    "package:check": "bun run build && bun x publint && bun x attw --pack --ignore-rules cjs-resolves-to-esm no-resolution",
    "prepack": "bun run build",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run validate",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "validate": "bun run format:check && bun run lint && bun run typecheck && bun run typecheck:test && bun run test && bun run build && bun run package:check && bun run verify:package-types",
    "verify:package-types": "bun run scripts/verify-package-types.ts",
    "verify:release-version": "bun run scripts/verify-release-version.ts"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "dotenv": "^17.2.0",
    "dotenv-expand": "^12.0.2",
    "jiti": "^2.4.2",
    "toml": "^3.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@happy-dom/global-registrator": "^18.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "ajv": "^8.17.1",
    "chalk": "^5.6.2",
    "expect-type": "^1.2.1",
    "fast-check": "^4.1.1",
    "happy-dom": "^18.0.1",
    "lefthook": "^2.1.10",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resolve.exports": "^2.0.3",
    "sort-package-json": "^4.0.0",
    "svelte": "^5.35.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=5",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "ts-morph": "^26.0.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
